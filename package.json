{
  "name": "translate-ai",
  "version": "1.1.2",
  "description": "Bilingual webpage reading and triple-space input translation for Chrome",
  "private": true,
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node --test tests/text.test.mjs tests/bridge.test.mjs && playwright test --project=regression --project=live",
    "test:unit": "node --test tests/text.test.mjs tests/bridge.test.mjs",
    "test:login": "node scripts/test-login.mjs",
    "bridge": "node bridge/server.mjs",
    "test:live": "playwright test --project=live",
    "test:regression": "playwright test --project=regression",
    "package": "node scripts/package.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Choi-sungjin/Translate-AI.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Choi-sungjin/Translate-AI/issues"
  },
  "homepage": "https://github.com/Choi-sungjin/Translate-AI#readme",
  "devDependencies": {
    "@lexical/rich-text": "0.52.0",
    "@playwright/test": "^1.64.1",
    "esbuild": "0.28.2",
    "lexical": "0.52.0"
  },
  "dependencies": {
    "@openai/codex": "0.162.1"
  }
}
